
# ============================================================
# .gitignore for a Quarto Website Project (Python and R)
#
# Original version contributed by OpenAI ChatGPT (GPT-6).
# Model settings: GPT-6, default ChatGPT configuration;
# no user-selected reasoning effort specified.
# Generated: November 12, 2026.
#
# Purpose: Exclude generated files, temporary files, caches,
# local environments, and system-specific artifacts.
# ============================================================

# ----------------------------
# Quarto
# ----------------------------
.quarto/
_site/
_freeze/
*_files/
*.quarto_ipynb

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/
.python-version

# ----------------------------
# Jupyter Notebook / JupyterLab
# ----------------------------
.ipynb_checkpoints/
.virtual_documents/
.jupyter/
.jupyterlab-workspace/
*.nbconvert.ipynb

# ----------------------------
# R and RStudio
# ----------------------------
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Renviron
.Rprofile

# R package artifacts
.Rcheck/
*.Rcheck/
*.tar.gz

# renv local library and staging
renv/library/
renv/staging/

# ----------------------------
# IDEs and Editors
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----------------------------
# Logs and Temporary Files
# ----------------------------
*.log
*.temp
*.cache
.cache/
tmp/
temp/

# ----------------------------
# Secrets and Local Configuration
# ----------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# ----------------------------
# Project-Specific Temporary Outputs
# ----------------------------
*.html~
*.pdf~
*.docx~
